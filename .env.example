# Backend address used by production builds. Leave it out locally:
# `npm run dev` forwards /api to localhost:3000 through Vite's proxy.
#
# For a deploy, put it in .env.production.local (git-ignored via *.local), e.g.
#   VITE_API_URL=https://api.quidey.example.com
# The value ends up in the public JavaScript bundle, so it must not be a secret.
VITE_API_URL=

# Sign in with Google: the OAuth client id of type "Web application" from Google Cloud Console
# (the same id the backend lists in GOOGLE_CLIENT_IDS). Public (it is in every sign-in link).
# Its "Authorized redirect URIs" must contain https://app.quidey.com/auth/google (and
# http://localhost:5173/auth/google for development). Empty: no Google button.
VITE_GOOGLE_CLIENT_ID=

# Quidey Pro (the subscription) is built in but switched off: "on" shows it (page /pro, menu,
# profile and beta screen cards, the legal texts' parts on Pro, /kuendigen). Turn it on together
# with PRO_BILLING=on on the server, and give the legal texts a new date (src/legal/owner.js).
VITE_PRO=off
