<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the app goes into cloud backups or device transfers. The WebView's
     storage holds the sign-in token (localStorage 'token'), which must not leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
