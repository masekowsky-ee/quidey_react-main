# The Android app's build (npm run build:android → vite build --mode android) talks to the
# production API. Public anyway: it ends up in the bundle.
VITE_API_URL=https://api.quidey.com
# Sign in with Google: the OAuth client id of type "Web application" (the same as the web app's
# VITE_GOOGLE_CLIENT_ID and the server's GOOGLE_CLIENT_IDS). Public. Empty: no Google button.
VITE_GOOGLE_CLIENT_ID=
